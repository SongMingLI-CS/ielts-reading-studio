[Unit]
Description=IELTS Reading Studio (web)
Documentation=file:/home/ubuntu/ielts-reading-studio/docs/operator-guide.md
After=network-online.target
Wants=network-online.target

# Restart policy: keep the site up, but back off so a crash loop cannot spin.
# systemd only reads StartLimit* from [Unit].
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ielts-reading-studio
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ubuntu/ielts-reading-studio/.env.web
# Loopback only: the companion unit ielts-reading-studio-tls runs Caddy on the public
# port 8766 and terminates TLS there. Binding 0.0.0.0 here would publish plaintext HTTP
# next to the HTTPS entry point and let anyone bypass the proxy.
# A loopback bind also means `serve` never runs its public-deployment gate, so
# scripts/deploy.sh --check enforces the same rules (credentials, session secret,
# HTTPS declaration, trusted proxies) before anything is restarted.
ExecStart=/home/ubuntu/ielts-reading-studio/.venv/bin/python -m app.cli serve --host 127.0.0.1 --port 8768

# Restart policy: keep the site up, but back off so a crash loop cannot spin.
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# Logging: everything goes to the journal, no application log files to rotate.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ielts-web

# Hardening. The application only writes to its own directory (output/, input/,
# backups/), so the rest of the filesystem stays read-only.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/home/ubuntu/ielts-reading-studio
UMask=0077

[Install]
WantedBy=multi-user.target
