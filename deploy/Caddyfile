# IELTS Learning Studio —— 公网 HTTPS 入口（Caddy 独立实例）
#
# 这份配置由 scripts/server-setup.sh 渲染后安装到
# /etc/caddy/ielts-reading-studio.caddyfile：站点地址占位符替换成 IELTS_TLS_SITE
# （默认 https://<公网IP>:8766），default_sni 占位符替换成同一个主机名。
#
# 为什么是这样（都是本机实测结论）：
#   1) 80 端口属于别的服务 → 不监听 80，也不做 http→https 跳转；
#   2) 443 端口留给同机另一个项目（Novel Agent）的 Caddy，因此沿用原来的 8766 端口号
#      （云安全组已经放行），只把协议从 http 换成 https；
#   3) 未备案域名在大陆机房会被按 SNI 拦截，而**浏览器访问 IP 时按 RFC 不发 SNI**：
#      实测无 SNI 的握手会以 `tlsv1 alert internal error` 失败，所以用 `default_sni`
#      指定站点主机名，让无 SNI 握手与带 SNI 一样拿到 SAN=IP 的内部证书；浏览器只会
#      提示「证书不受信任」，不会有域名不匹配。（也试过「同端口兜底站点」，Caddy 拒绝
#      在同一个端口混合 HTTP/HTTPS，见 git 历史。）
#   4) 应用只监听 127.0.0.1:8768，Caddy 是唯一的网络入口。
#
# 换成受信任证书（有已备案域名后）：把站点地址改成 https://你的域名、删掉 tls internal
# （default_sni 会随站点主机名一起变化），并让 80 端口或 DNS 能完成 ACME 校验即可。

{
	# 管理接口只在本机、且换到 2020，避免与共享的 caddy.service（2019）冲突
	admin 127.0.0.1:2020
	# 80 端口属于别的服务：不绑定 80、不做 http→https 跳转
	auto_https disable_redirects
	# 浏览器访问 https://IP 时不发 SNI（RFC 6066 禁止把 IP 放进 SNI）。实测：没有这个
	# 默认值时无 SNI 握手会以 `tlsv1 alert internal error` 失败；设成站点主机名后，
	# 无 SNI 握手与带 SNI 一样拿到 SAN=IP 的证书（浏览器随后提示「证书不受信任」）。
	default_sni {{DEFAULT_SNI}}
}

# 站点公共部分：反代、安全头、日志。
(ielts_site) {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8768 {
		# 应用据此判断请求经过 HTTPS（IELTS_WEB_TRUSTED_PROXIES 必须含 127.0.0.1）
		header_up X-Forwarded-Proto https
	}

	# 应用自身已发送 nosniff / X-Frame-Options / Referrer-Policy / CSP，这里只补 HSTS
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stderr
		format console
	}
}

# 主站点：Caddy 为它签发 SAN=IP 的内部证书
{{SITE_ADDRESS}} {
	tls internal
	import ielts_site
}

