[Unit]
Description=IELTS Reading Studio TLS front (Caddy, self-signed certificate)
Documentation=file:/home/ubuntu/ielts-reading-studio/docs/operator-guide.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# A dedicated Caddy instance: it reads its own config file, so it never touches
# /etc/caddy/Caddyfile or the shared caddy.service (other sites on this host keep their own
# front). It is the only process bound to the public port; the application itself listens
# on 127.0.0.1:8768. Certificates and the internal CA stay in the caddy user's default data
# directory (/var/lib/caddy), which the packaging already creates.
Type=notify
User=caddy
Group=caddy
ExecStart=/usr/bin/caddy run --environ --config /etc/caddy/ielts-reading-studio.caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /etc/caddy/ielts-reading-studio.caddyfile --adapter caddyfile --address 127.0.0.1:2020 --force
TimeoutStopSec=5s
LimitNOFILE=1048576
PrivateTmp=true
ProtectSystem=full
# 8766 is above 1024, so no privileged port: keep the capability set empty.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
