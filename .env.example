DEEPSEEK_API_KEY=
# Required only when serving on a non-localhost address.
IELTS_WEB_USERNAME=
IELTS_WEB_PASSWORD=
# Minimum password length the production gate enforces (default 12, floor 8).
# Lowering it is a deliberate, documented risk decision - see docs/security.md 第 5 节.
IELTS_WEB_PASSWORD_MIN_LENGTH=
# Session key used to hash session ids at rest. Required for public deployments
# (>= 32 characters, e.g. `openssl rand -hex 32`).
IELTS_WEB_SESSION_SECRET=
# Declare that TLS terminates at a trusted reverse proxy (required in production).
IELTS_WEB_FORCE_HTTPS=
# Comma-separated IPs/CIDRs of the reverse proxy; empty means "trust no forwarding headers".
# Example: 127.0.0.1,172.16.0.0/12
IELTS_WEB_TRUSTED_PROXIES=
# Force the Secure cookie attribute even when the request looks like plain HTTP
# (only for unusual proxy setups; normally derived from IELTS_WEB_FORCE_HTTPS).
IELTS_WEB_COOKIE_SECURE=
